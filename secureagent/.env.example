# ────────────────────────────────────────────────────────────────────────────
# SecureAgent — Environment Variables
# Copy this file to .env.local (frontend) and .env (backend) and fill in values.
# NEVER commit real secrets. NEVER use NEXT_PUBLIC_ for any secret.
# ────────────────────────────────────────────────────────────────────────────

# ── Frontend (Next.js) — .env.local ─────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_32_CHARS_MIN_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App credentials (create at github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# BFF → FastAPI (server-side ONLY — no NEXT_PUBLIC_ prefix)
BACKEND_URL=http://localhost:8000
BACKEND_SECRET=CHANGE_ME_32_CHARS_MIN_BACKEND_SECRET
JWT_EXPIRY_SECONDS=600

# ── Backend (FastAPI) — .env ─────────────────────────────────────────────────
# Local development default (SQLite file):
DATABASE_URL=sqlite+aiosqlite:///./secureagent.db

# Production on Render using Turso (libSQL):
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Alternatively, Production using PostgreSQL (e.g. Render Postgres or Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

REDIS_URL=redis://localhost:6379/0

# Must match BACKEND_SECRET above
BACKEND_SECRET=CHANGE_ME_32_CHARS_MIN_BACKEND_SECRET

# Fernet key for encrypting GitHub tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Frontend URL for CORS allowlist (supports comma-separated origins, e.g. https://your-app.vercel.app,http://localhost:3000)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=https://your-app.vercel.app

# ── Workspace ─────────────────────────────────────────────────────────────────
# Directory for temporary git checkouts and scans
# Linux / Render: /tmp/secureagent/workspaces (leave blank to auto-default)
# Windows: ./workspaces
WORKSPACE_ROOT=./workspaces

# ── LLM (Gemini) ─────────────────────────────────────────────────────────────
LLM_PROVIDER=google
LLM_TRIAGE_MODEL=gemini-3.6-flash
LLM_FIX_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Scan Limits ───────────────────────────────────────────────────────────────
MAX_REPO_SIZE_MB=100
MAX_FILES_TO_SCAN=1000
MAX_LLM_TOKENS_PER_SCAN=200000
MAX_FINDINGS_TO_FIX=10
MAX_PATCH_LINES=200
CONFIDENCE_THRESHOLD=0.7
AUTO_FIX_SEVERITIES=critical,high,medium
MAX_FIX_ATTEMPTS=3

# ── Concurrency & Timeouts ────────────────────────────────────────────────────
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_TOTAL=1800

# ── Remediation Notifications ─────────────────────────────────────────────
# Frequency at which the remediator alerts users of unresolved vulnerabilities (minutes, default 60 = 1 hour)
REMEDIATION_NOTIFICATION_INTERVAL_MINUTES=60

# ── Docker Sandbox ────────────────────────────────────────────────────────────
SANDBOX_IMAGE=secureagent-sandbox:latest
SANDBOX_CPU=0.5
SANDBOX_MEMORY=512m
SANDBOX_TIMEOUT=120
SEMGREP_TIMEOUT=120

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
